# =============================================================================
# Universal Korporativ Kataloq Platforması — mühit dəyişənləri
#
# Bu faylı `.env` adı ilə kopyalayın və dəyərləri doldurun:
#   cp .env.example .env
#
# `.env` heç vaxt git-ə əlavə edilməməlidir.
# =============================================================================

# --- Database ----------------------------------------------------------------
DB_NAME=catalog
DB_USERNAME=catalog
# MÜTLƏQ dəyişin. Güclü parol yaradın:  openssl rand -base64 24
DB_PASSWORD=
DB_PORT=5432

# --- Security ----------------------------------------------------------------
# MÜTLƏQ dəyişin. Minimum 32 simvol:  openssl rand -base64 48
JWT_SECRET=

# İlk SUPER_ADMIN hesabı. ADMIN_PASSWORD boş qalarsa sistem güclü parol yaradıb
# ilk başlanğıcda loglara BİR DƏFƏ yazır.
ADMIN_EMAIL=admin@company.az
ADMIN_PASSWORD=

# HTTPS-də mütləq true olmalıdır.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# --- URLs --------------------------------------------------------------------
# İstehsalatda öz domeninizi yazın: https://example.az
PUBLIC_URL=http://localhost
API_URL=http://localhost/api
CORS_ORIGINS=http://localhost
HTTP_PORT=80
VITE_API_URL=/api

# --- Spring ------------------------------------------------------------------
SPRING_PROFILE=prod

# Nümunə kataloq (12 məhsul, 3 canlı kampaniya, 2 promo kod) yüklənsin?
# Boş = yüklənmir. Yükləmək üçün:  DEMO_DATA_LOCATION=,classpath:db/demo
DEMO_DATA_LOCATION=

# --- Payment -----------------------------------------------------------------
# mock | stripe
# `mock` — tam işlək test provayderi (bank müqaviləsi tələb etmir).
PAYMENT_PROVIDER=mock
# MÜTLƏQ dəyişin:  openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- Mail --------------------------------------------------------------------
# false olduqda məktublar göndərilmir, yalnız loga yazılır.
MAIL_ENABLED=false
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=noreply@company.az
MAIL_ADMIN_TO=admin@company.az

# --- Commerce ----------------------------------------------------------------
COMMERCE_ENABLED=true
DEFAULT_CURRENCY=AZN
FREE_DELIVERY_THRESHOLD=150
DELIVERY_PRICE=5

# --- Chat --------------------------------------------------------------------
CHAT_ENABLED=true

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
SQL_LOG_LEVEL=WARN
